{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRPLauncher",
  "version": "0.24.0",
  "identifier": "pro.limacashout.grplauncher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "GRP Launcher", "width": 1000, "height": 620, "resizable": false, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Aquilabot",
    "copyright": "Copyright (c) 2026 Aquilabot. MPL-2.0",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
