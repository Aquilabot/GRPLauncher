  "narrative": {
    "northStar": "The Cross-Com Visor",
    "overview": "The window reads as the game's own targeting visor, not a store page. A blue-black ground carries thin teal hairlines and line readouts; labels attach to what they describe through leader lines. One cyan signal marks what is live, chosen or focused. Amber marks what is new. Red-orange marks what failed.",
    "keyCharacteristics": [
      "Blue-black ground, teal hairlines, one cyan signal; amber and red-orange only for state.",
      "Square everything; the 9px chamfer belongs to the play plate only.",
      "Two Barlow cuts: Condensed SemiBold for uppercase labels, Semi Condensed for reading text.",
      "Tabular, lining figures everywhere.",
      "Flat: no shadows, blur, glow or glass.",
      "Motion is spent in one place: the terrain scan and server tag."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Cyan means live, chosen or focused; never decoration or a second brand color.",
        "section": "colors"
      },
      {
        "name": "The State Colors Rule",
        "body": "Amber means new, coral means failed, for those meanings only.",
        "section": "colors"
      },
      {
        "name": "The Hue Family Rule",
        "body": "Every neutral and text tone stays in the teal-blue family; no pure grey or white.",
        "section": "colors"
      },
      {
        "name": "The Two Faces Rule",
        "body": "Uppercase tracked text is Barlow Condensed; sentence-case text is Barlow Semi Condensed.",
        "section": "typography"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Figures stay tabular and lining so values do not shift as they change.",
        "section": "typography"
      },
      {
        "name": "The Flat Rule",
        "body": "Surfaces never lift; a state change is a color, border color or 1px nudge.",
        "section": "elevation"
      },
      {
        "name": "The Hairline Rule",
        "body": "Separation is a 1px line or line-hi border; dashed means disabled.",
        "section": "elevation"
      },
      {
        "name": "The One Moment Rule",
        "body": "The terrain-and-tag reveal is the only choreographed animation.",
        "section": "motion"
      }
    ],
    "dos": [
      "Do use signal only for live, chosen or focused things, and fresh and fault only for new and failed.",
      "Do keep every control square, 36px high (34 for the account switch), with a 1px hairline border.",
      "Do keep disabled as ink-3 text with a dashed border, never as opacity alone.",
      "Do keep the operator column and the play plate on screen on every view.",
      "Do keep the status block at a fixed height with plain, translated errors.",
      "Do keep a visible signal focus ring on every interactive element.",
      "Do keep the page fully local: bundled fonts, inline SVG, no external requests."
    ],
    "donts": [
      "Don't add shadows, blur, glow, glass, decorative gradients or rounded corners.",
      "Don't put key art, a hero image, Ubisoft artwork or a game logotype anywhere.",
      "Don't add a second accent color or a light theme.",
      "Don't put a donation or promotional element between the player and the play plate.",
      "Don't set sentences in uppercase or labels in the text face.",
      "Don't add breakpoints; the window is fixed.",
      "Don't add entrance animations to new surfaces.",
      "Don't drop hint or placeholder text below ink-3."
    ]
  }
